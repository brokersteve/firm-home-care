{
  "name": "firm-app",
  "version": "1.0.0",
  "description": "The FIRM phone app for iPhone and Android: a native shell around F.I.R.M. Home Care",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "icons": "node make-icons.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#1f5f8b' --splashBackgroundColor '#1f5f8b' --iconBackgroundColorDark '#1f5f8b' --splashBackgroundColorDark '#1f5f8b'",
