    "@capacitor/splash-screen": "^8.0.2",
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "typescript": "^5.9.3"
  }
